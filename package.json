{
  "name": "lector-ai",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:extension": "node scripts/dev-extension.mjs",
    "build": "vite build",
    "build:extension": "node scripts/build-extension.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "node tests/browser/run-browser-e2e.mjs && node tests/browser/run-sidepanel-e2e.mjs && node tests/browser/run-background-e2e.mjs",
    "test:browser:content": "node tests/browser/run-browser-e2e.mjs",
    "test:browser:sidepanel": "node tests/browser/run-sidepanel-e2e.mjs",
    "test:browser:background": "node tests/browser/run-background-e2e.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.38",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.19.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "jsdom": "^25.0.1",
    "playwright": "^1.61.0",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "~5.5.3",
    "vite": "^5.3.5",
    "vitest": "^2.1.9",
    "ws": "^8.21.0"
  }
}
